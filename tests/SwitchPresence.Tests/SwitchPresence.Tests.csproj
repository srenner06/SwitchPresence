<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 test projects host their own runner, so they must be executables.
         The runner is selected in global.json ("test": { "runner": ... }). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- xunit.v3 hosts Microsoft.Testing.Platform itself. Microsoft.NET.Test.Sdk,
         xunit.runner.visualstudio and coverlet.collector are VSTest-era and would drag the
         unsupported VSTest target back in. -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SwitchPresence.Core\SwitchPresence.Core.csproj" />
  </ItemGroup>
</Project>